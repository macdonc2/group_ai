# OpenAI API Key (OPTIONAL - for local development only)
# In production, users manage their own API keys via Settings
# Leave empty or remove to require user-provided keys
OPENAI_API_KEY=

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./agent_system.db

# Neo4j Graph Database (optional - knowledge graph features)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# JWT Secret Key (required - generate a secure random string)
SECRET_KEY=your-secret-key-for-jwt-min-32-chars

# Encryption Key for user API keys (required for production)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Optional: Default LLM Model (use full snapshot names for compatibility)
DEFAULT_MODEL=gpt-6-astra
FALLBACK_MODEL=gpt-5.6-luna
# Deep Research narration (OpenAI TTS)
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=marin
# Optional: higher rate limits for the research lanes
# SEMANTIC_SCHOLAR_API_KEY=
# GITHUB_TOKEN=
