# Backend Dockerfile for Agent System
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# uv, pinned to the version CI uses
RUN pip install --no-cache-dir uv==0.9.8

# Install exactly the versions in uv.lock, the same ones CI tests against.
# --locked fails the build if uv.lock no longer matches pyproject.toml, and the
# exported file carries hashes, so a tampered or re-uploaded package is refused.
# Dependencies go in before the source so this layer is reused when only code
# changes.
COPY pyproject.toml uv.lock README.md ./
RUN uv export --locked --no-dev --no-emit-project -o /tmp/requirements.txt \
    && uv pip install --system --no-cache --require-hashes -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

# The app itself (non-editable), with no dependency resolution
COPY src/ ./src/
RUN uv pip install --system --no-cache --no-deps .

# Headless Chromium for reading JavaScript-rendered pages (web_search / read_webpage).
# The shell-only build is enough for text; installed where the non-root user can read it.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN python -m playwright install --with-deps --only-shell chromium \
    && chmod -R a+rX /ms-playwright \
    && rm -rf /var/lib/apt/lists/*

# Set late: it changes on every commit and would otherwise invalidate the
# dependency and browser layers above.
ARG GIT_SHA=""
ENV GIT_SHA=${GIT_SHA}

# Create non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "agent_system.adapters.inbound.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
